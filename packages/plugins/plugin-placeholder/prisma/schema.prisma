generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PluginPlaceholderDummyRecord {
  id        String   @id @default(cuid())
  label     String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model PluginPlaceholderDummyAudit {
  id        String   @id @default(cuid())
  action    String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
