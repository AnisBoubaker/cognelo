generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CourseStatus {
  draft
  published
  archived
}

enum CourseMembershipRole {
  owner
  teacher
  ta
  student
}

enum MaterialKind {
  folder
  text
  markdown
  pdf
  link
  github_repo
  code_example
  dataset
  file
  module
}

enum CourseContentItemKind {
  folder
  material
  activity
}

enum ActivityLifecycle {
  draft
  published
  paused
  archived
}

enum CourseGroupStatus {
  draft
  published
}

enum CourseGroupParticipantRole {
  teacher
  ta
  student
}

enum AiAgentProvider {
  ollama
  openai
  codex
  claude
}

enum GradebookGradingMode {
  points
  pass_fail
}

enum GradebookAttemptLimitMode {
  unlimited
  max_attempts
  until_due
}

enum GradebookGradeStrategy {
  latest
  best
  first
  weighted_average
}

enum ActivityAttemptLifecycle {
  started
  submitted
  graded
  deleted
}

enum GradeSource {
  auto
  manual
  override
  regrade
}

enum GradeEventType {
  auto_graded
  manual_graded
  overridden
  regraded
  released
  hidden
  submission_deleted
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String?
  firstName               String?
  lastName                String?
  metadata                Json                     @default("{}")
  passwordHash            String
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  roles                   UserRole[]
  courses                 CourseMembership[]
  createdCourses          Course[]                 @relation("CourseCreator")
  createdSubjects         Subject[]                @relation("SubjectCreator")
  createdSubjectMaterials SubjectMaterial[]        @relation("SubjectMaterialCreator")
  ownedActivityBanks      ActivityBank[]           @relation("ActivityBankOwner")
  materials               CourseMaterial[]         @relation("MaterialCreator")
  activities              Activity[]               @relation("ActivityCreator")
  createdBankActivities   BankActivity[]           @relation("BankActivityCreator")
  createdActivityVersions ActivityVersion[]        @relation("ActivityVersionCreator")
  createdGroups           CourseGroup[]            @relation("CourseGroupCreator")
  groupParticipants       CourseGroupParticipant[]
  groupMaterials          CourseGroupMaterial[]    @relation("GroupMaterialCreator")
  aiAgentConnections      AiAgentConnection[]
  activityAttempts        ActivityAttempt[]        @relation("ActivityAttemptUser")
  grades                  Grade[]                  @relation("GradeUser")
  gradedGrades            Grade[]                  @relation("GradeGrader")
  gradeEvents             GradeEvent[]             @relation("GradeEventActor")

  @@index([email])
}

model AiAgentConnection {
  id          String          @id @default(cuid())
  ownerId     String?
  provider    AiAgentProvider
  displayName String
  model       String
  baseUrl     String?
  apiKey      String?
  isEnabled   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner       User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([provider])
  @@index([isEnabled])
}

model Role {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  users       UserRole[]
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Course {
  id               String              @id @default(cuid())
  subjectId        String
  title            String
  description      String              @default("")
  status           CourseStatus        @default(draft)
  metadata         Json                @default("{}")
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  subject          Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy        User                @relation("CourseCreator", fields: [createdById], references: [id])
  memberships      CourseMembership[]
  materials        CourseMaterial[]
  activities       Activity[]
  groups           CourseGroup[]
  gradebookItems   GradebookItem[]
  activityAttempts ActivityAttempt[]
  contentItems     CourseContentItem[]

  @@index([subjectId])
  @@index([status])
  @@index([createdById])
}

model Subject {
  id            String            @id @default(cuid())
  title         String
  description   String            @default("")
  metadata      Json              @default("{}")
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  createdBy     User              @relation("SubjectCreator", fields: [createdById], references: [id])
  courses       Course[]
  materials     SubjectMaterial[]
  activityBanks ActivityBank[]

  @@index([createdById])
  @@index([updatedAt])
}

model SubjectMaterial {
  id          String            @id @default(cuid())
  subjectId   String
  parentId    String?
  title       String
  kind        MaterialKind
  body        String?
  url         String?
  metadata    Json              @default("{}")
  position    Int               @default(0)
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  subject     Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("SubjectMaterialCreator", fields: [createdById], references: [id])
  parent      SubjectMaterial?  @relation("SubjectMaterialTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    SubjectMaterial[] @relation("SubjectMaterialTree")

  @@index([subjectId, position])
  @@index([subjectId, parentId, position])
  @@index([kind])
}

model ActivityBank {
  id          String         @id @default(cuid())
  subjectId   String
  title       String
  description String         @default("")
  ownerId     String
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  owner       User           @relation("ActivityBankOwner", fields: [ownerId], references: [id])
  activities  BankActivity[]

  @@index([subjectId, updatedAt])
  @@index([ownerId])
}

model CourseMembership {
  id        String               @id @default(cuid())
  courseId  String
  userId    String
  role      CourseMembershipRole
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  course    Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId, role])
  @@index([courseId])
  @@index([userId])
}

model CourseMaterial {
  id                       String                            @id @default(cuid())
  courseId                 String
  parentId                 String?
  title                    String
  kind                     MaterialKind
  body                     String?
  url                      String?
  metadata                 Json                              @default("{}")
  position                 Int                               @default(0)
  createdById              String
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  course                   Course                            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy                User                              @relation("MaterialCreator", fields: [createdById], references: [id])
  parent                   CourseMaterial?                   @relation("MaterialTree", fields: [parentId], references: [id], onDelete: SetNull)
  children                 CourseMaterial[]                  @relation("MaterialTree")
  groupVisibilityOverrides CourseGroupHiddenCourseMaterial[]
  contentItems             CourseContentItem[]

  @@index([courseId, position])
  @@index([courseId, parentId, position])
  @@index([kind])
}

model CourseGroup {
  id                    String                            @id @default(cuid())
  courseId              String
  title                 String
  description           String                            @default("")
  status                CourseGroupStatus                 @default(draft)
  availableFrom         DateTime?
  availableUntil        DateTime?
  createdById           String
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  course                Course                            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy             User                              @relation("CourseGroupCreator", fields: [createdById], references: [id])
  materials             CourseGroupMaterial[]
  activities            CourseGroupActivity[]
  participants          CourseGroupParticipant[]
  hiddenCourseMaterials CourseGroupHiddenCourseMaterial[]
  gradebookItems        GradebookItem[]
  activityAttempts      ActivityAttempt[]
  contentItems          CourseContentItem[]

  @@index([courseId, updatedAt])
  @@index([status, availableFrom, availableUntil])
  @@index([createdById])
}

model CourseGroupParticipant {
  id               String                     @id @default(cuid())
  groupId          String
  userId           String?
  role             CourseGroupParticipantRole @default(student)
  firstName        String
  lastName         String
  email            String
  externalId       String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  group            CourseGroup                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user             User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  activityAttempts ActivityAttempt[]
  grades           Grade[]
  gradeEvents      GradeEvent[]

  @@unique([groupId, email])
  @@index([groupId, createdAt])
  @@index([email])
  @@index([userId])
}

model CourseGroupMaterial {
  id          String                @id @default(cuid())
  groupId     String
  parentId    String?
  title       String
  kind        MaterialKind
  body        String?
  url         String?
  metadata    Json                  @default("{}")
  position    Int                   @default(0)
  createdById String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  group       CourseGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User                  @relation("GroupMaterialCreator", fields: [createdById], references: [id])
  parent      CourseGroupMaterial?  @relation("CourseGroupMaterialTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    CourseGroupMaterial[] @relation("CourseGroupMaterialTree")

  @@index([groupId, position])
  @@index([groupId, parentId, position])
  @@index([kind])
}

model CourseGroupActivity {
  id               String              @id @default(cuid())
  groupId          String
  activityId       String
  availableFrom    DateTime?
  availableUntil   DateTime?
  config           Json                @default("{}")
  metadata         Json                @default("{}")
  position         Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  group            CourseGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  activity         Activity            @relation(fields: [activityId], references: [id], onDelete: Cascade)
  gradebookItem    GradebookItem?
  activityAttempts ActivityAttempt[]
  contentItems     CourseContentItem[]

  @@unique([groupId, activityId])
  @@index([groupId, position])
  @@index([activityId])
}

model CourseGroupHiddenCourseMaterial {
  groupId          String
  courseMaterialId String
  createdAt        DateTime       @default(now())
  group            CourseGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseMaterial   CourseMaterial @relation(fields: [courseMaterialId], references: [id], onDelete: Cascade)

  @@id([groupId, courseMaterialId])
  @@index([courseMaterialId])
}

model ActivityType {
  id               String            @id @default(cuid())
  key              String            @unique
  name             String
  description      String
  version          String            @default("0.1.0")
  metadata         Json              @default("{}")
  isEnabled        Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  activities       Activity[]
  bankActivities   BankActivity[]
  activityVersions ActivityVersion[]
}

model ActivityPluginInstallation {
  id            String                      @id @default(cuid())
  key           String                      @unique
  packageName   String
  name          String
  version       String                      @default("0.1.0")
  metadata      Json                        @default("{}")
  isActivated   Boolean                     @default(false)
  isEnabled     Boolean                     @default(true)
  activatedAt   DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  tableBackups  ActivityPluginTableBackup[]

  @@index([isActivated])
  @@index([isEnabled])
}

model ActivityPluginTableBackup {
  id            String                     @id @default(cuid())
  pluginKey     String
  pluginVersion String
  sourceTables  Json                       @default("[]")
  backupTables  Json                       @default("[]")
  restoredAt    DateTime?
  createdAt     DateTime                   @default(now())
  installation  ActivityPluginInstallation @relation(fields: [pluginKey], references: [key], onDelete: Cascade)

  @@index([pluginKey, pluginVersion])
  @@index([restoredAt])
}

model BankActivity {
  id               String            @id @default(cuid())
  bankId           String
  activityTypeId   String
  title            String
  description      String            @default("")
  lifecycle        ActivityLifecycle @default(draft)
  config           Json              @default("{}")
  metadata         Json              @default("{}")
  position         Int               @default(0)
  currentVersionId String?
  createdById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bank             ActivityBank      @relation(fields: [bankId], references: [id], onDelete: Cascade)
  activityType     ActivityType      @relation(fields: [activityTypeId], references: [id])
  currentVersion   ActivityVersion?  @relation("CurrentBankActivityVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  createdBy        User              @relation("BankActivityCreator", fields: [createdById], references: [id])
  versions         ActivityVersion[] @relation("BankActivityVersions")
  courseActivities Activity[]

  @@index([bankId, position])
  @@index([activityTypeId])
  @@index([currentVersionId])
}

model ActivityVersion {
  id                       String            @id @default(cuid())
  bankActivityId           String
  versionNumber            Int
  activityTypeId           String
  title                    String
  description              String            @default("")
  lifecycle                ActivityLifecycle @default(draft)
  config                   Json              @default("{}")
  metadata                 Json              @default("{}")
  createdById              String
  createdAt                DateTime          @default(now())
  bankActivity             BankActivity      @relation("BankActivityVersions", fields: [bankActivityId], references: [id], onDelete: Cascade)
  currentForBankActivities BankActivity[]    @relation("CurrentBankActivityVersion")
  activityType             ActivityType      @relation(fields: [activityTypeId], references: [id])
  createdBy                User              @relation("ActivityVersionCreator", fields: [createdById], references: [id])
  courseActivities         Activity[]
  activityAttempts         ActivityAttempt[]

  @@unique([bankActivityId, versionNumber])
  @@index([bankActivityId, createdAt])
  @@index([activityTypeId])
}

model Activity {
  id                String                @id @default(cuid())
  courseId          String
  bankActivityId    String?
  activityVersionId String?
  activityTypeId    String
  title             String
  description       String                @default("")
  lifecycle         ActivityLifecycle     @default(draft)
  config            Json                  @default("{}")
  metadata          Json                  @default("{}")
  position          Int                   @default(0)
  createdById       String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  course            Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  bankActivity      BankActivity?         @relation(fields: [bankActivityId], references: [id], onDelete: SetNull)
  activityVersion   ActivityVersion?      @relation(fields: [activityVersionId], references: [id], onDelete: SetNull)
  activityType      ActivityType          @relation(fields: [activityTypeId], references: [id])
  createdBy         User                  @relation("ActivityCreator", fields: [createdById], references: [id])
  groupAssignments  CourseGroupActivity[]
  gradebookItems    GradebookItem[]
  activityAttempts  ActivityAttempt[]
  contentItems      CourseContentItem[]

  @@index([courseId, position])
  @@index([bankActivityId])
  @@index([activityVersionId])
  @@index([activityTypeId])
  @@index([lifecycle])
}

model CourseContentItem {
  id                    String                @id @default(cuid())
  courseId              String
  groupId               String?
  parentId              String?
  kind                  CourseContentItemKind
  titleSnapshot         String?
  position              Int                   @default(0)
  isVisible             Boolean               @default(true)
  materialId            String?
  activityId            String?
  courseGroupActivityId String?
  metadata              Json                  @default("{}")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  course                Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group                 CourseGroup?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parent                CourseContentItem?    @relation("CourseContentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children              CourseContentItem[]   @relation("CourseContentTree")
  material              CourseMaterial?       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  activity              Activity?             @relation(fields: [activityId], references: [id], onDelete: Cascade)
  groupActivity         CourseGroupActivity?  @relation(fields: [courseGroupActivityId], references: [id], onDelete: Cascade)

  @@index([courseId, groupId, parentId, position])
  @@index([courseId, parentId, position])
  @@index([groupId, parentId, position])
  @@index([parentId])
  @@index([kind])
  @@index([isVisible])
  @@index([materialId])
  @@index([activityId])
  @@index([courseGroupActivityId])
}

model GradebookItem {
  id                         String                    @id @default(cuid())
  courseId                   String
  groupId                    String
  groupActivityId            String                    @unique
  activityId                 String
  titleSnapshot              String
  pointsPossible             Float                     @default(100)
  gradingMode                GradebookGradingMode      @default(points)
  passThresholdPoints        Float?
  passThresholdOutOf         Float?
  attemptLimitMode           GradebookAttemptLimitMode @default(unlimited)
  maxAttempts                Int?
  gradeStrategy              GradebookGradeStrategy    @default(latest)
  dropLowestAttempt          Boolean                   @default(false)
  lateSubmissionsAllowed     Boolean                   @default(false)
  latePenaltyPercent         Float?
  latePenaltyIntervalMinutes Int?
  latePenaltyMaxPercent      Float?
  lateGracePeriodMinutes     Int?
  gradesReleased             Boolean                   @default(false)
  metadata                   Json                      @default("{}")
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  course                     Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group                      CourseGroup               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupActivity              CourseGroupActivity       @relation(fields: [groupActivityId], references: [id], onDelete: Cascade)
  activity                   Activity                  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  attempts                   ActivityAttempt[]
  grades                     Grade[]
  events                     GradeEvent[]

  @@index([courseId, groupId])
  @@index([courseId, activityId])
  @@index([groupId, activityId])
  @@index([activityId])
  @@index([gradesReleased])
}

model ActivityAttempt {
  id                        String                   @id @default(cuid())
  courseId                  String
  groupId                   String
  groupActivityId           String
  activityId                String
  gradebookItemId           String
  participantId             String
  userId                    String?
  attemptNumber             Int
  lifecycle                 ActivityAttemptLifecycle @default(started)
  startedAt                 DateTime                 @default(now())
  submittedAt               DateTime?
  gradedAt                  DateTime?
  durationSeconds           Int?
  isLate                    Boolean                  @default(false)
  lateBySeconds             Int?
  activityVersionId         String?
  activityConfigFingerprint String?
  pluginKey                 String
  pluginVersion             String
  pluginAttemptRef          String?
  metadata                  Json                     @default("{}")
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  course                    Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group                     CourseGroup              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupActivity             CourseGroupActivity      @relation(fields: [groupActivityId], references: [id], onDelete: Cascade)
  activity                  Activity                 @relation(fields: [activityId], references: [id], onDelete: Cascade)
  gradebookItem             GradebookItem            @relation(fields: [gradebookItemId], references: [id], onDelete: Cascade)
  participant               CourseGroupParticipant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user                      User?                    @relation("ActivityAttemptUser", fields: [userId], references: [id], onDelete: SetNull)
  activityVersion           ActivityVersion?         @relation(fields: [activityVersionId], references: [id], onDelete: SetNull)
  selectedForGrades         Grade[]
  gradeEvents               GradeEvent[]

  @@unique([gradebookItemId, participantId, attemptNumber])
  @@index([courseId, groupId, activityId])
  @@index([gradebookItemId, participantId])
  @@index([participantId, createdAt])
  @@index([userId])
  @@index([lifecycle])
  @@index([pluginKey, pluginAttemptRef])
  @@index([activityVersionId])
}

model Grade {
  id                 String                 @id @default(cuid())
  gradebookItemId    String
  participantId      String
  userId             String?
  selectedAttemptId  String?
  rawScore           Float
  rawMaxScore        Float
  normalizedScore    Float
  normalizedMaxScore Float
  isPass             Boolean?
  latePenaltyApplied Boolean                @default(false)
  latePenaltyPercent Float?
  gradedByUserId     String?
  gradedAt           DateTime               @default(now())
  source             GradeSource
  rawResult          Json                   @default("{}")
  normalizedResult   Json                   @default("{}")
  metadata           Json                   @default("{}")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  gradebookItem      GradebookItem          @relation(fields: [gradebookItemId], references: [id], onDelete: Cascade)
  participant        CourseGroupParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user               User?                  @relation("GradeUser", fields: [userId], references: [id], onDelete: SetNull)
  selectedAttempt    ActivityAttempt?       @relation(fields: [selectedAttemptId], references: [id], onDelete: SetNull)
  gradedBy           User?                  @relation("GradeGrader", fields: [gradedByUserId], references: [id], onDelete: SetNull)
  events             GradeEvent[]

  @@unique([gradebookItemId, participantId])
  @@index([participantId])
  @@index([userId])
  @@index([selectedAttemptId])
  @@index([gradedByUserId])
  @@index([source])
  @@index([gradedAt])
}

model GradeEvent {
  id              String                 @id @default(cuid())
  gradeId         String?
  gradebookItemId String
  participantId   String
  attemptId       String?
  actorUserId     String?
  eventType       GradeEventType
  previousValue   Json?
  nextValue       Json?
  reason          String?
  metadata        Json                   @default("{}")
  createdAt       DateTime               @default(now())
  grade           Grade?                 @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  gradebookItem   GradebookItem          @relation(fields: [gradebookItemId], references: [id], onDelete: Cascade)
  participant     CourseGroupParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  attempt         ActivityAttempt?       @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  actor           User?                  @relation("GradeEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([gradeId, createdAt])
  @@index([gradebookItemId, participantId, createdAt])
  @@index([participantId])
  @@index([attemptId])
  @@index([actorUserId])
  @@index([eventType])
  @@index([createdAt])
}
