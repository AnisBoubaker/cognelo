generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PluginCodingExerciseExecutionKind {
  run
  submit
}

enum PluginCodingExerciseExecutionStatus {
  pending
  completed
  failed
}

model PluginCodingExerciseHiddenTest {
  id             String   @id @default(cuid())
  activityId     String
  name           String
  stdin          String   @default("")
  expectedOutput String   @default("")
  orderIndex     Int      @default(0)
  isEnabled      Boolean  @default(true)
  weight         Int      @default(1)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([activityId, orderIndex])
  @@index([activityId, isEnabled])
}

model PluginCodingExerciseReferenceSolution {
  id                String   @id @default(cuid())
  activityId        String   @unique
  sourceCode        String
  privateConfig     Json     @default("{}")
  validationSummary Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PluginBankCodingExerciseHiddenTest {
  id             String   @id @default(cuid())
  bankActivityId String
  name           String
  stdin          String   @default("")
  expectedOutput String   @default("")
  orderIndex     Int      @default(0)
  isEnabled      Boolean  @default(true)
  weight         Int      @default(1)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([bankActivityId, orderIndex])
  @@index([bankActivityId, isEnabled])
}

model PluginBankCodingExerciseReferenceSolution {
  id                String   @id @default(cuid())
  bankActivityId    String   @unique
  sourceCode        String
  privateConfig     Json     @default("{}")
  validationSummary Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PluginCodingExerciseExecution {
  id                       String                              @id @default(cuid())
  activityId               String
  userId                   String
  kind                     PluginCodingExerciseExecutionKind   @default(run)
  status                   PluginCodingExerciseExecutionStatus @default(pending)
  languageKey              String
  judge0LanguageId         Int
  sourceCode               String
  stdin                    String?                             @default("")
  expectedOutput           String?                             @default("")
  judge0Token              String?
  stdout                   String?
  stderr                   String?
  compileOutput            String?
  message                  String?
  timeSeconds              String?
  memoryKb                 Int?
  judge0StatusId           Int?
  judge0StatusLabel        String?
  resultSummary            Json                                @default("{}")
  aiFeedbackConfigSnapshot Json?
  createdAt                DateTime                            @default(now())
  updatedAt                DateTime                            @updatedAt

  @@index([activityId, userId, createdAt])
  @@index([userId, createdAt])
  @@index([activityId, kind, createdAt])
  @@index([judge0Token])
}

model PluginCodingExerciseAiEvaluation {
  id                 String   @id @default(cuid())
  activityId         String
  executionId        String
  coreAttemptId      String?
  courseId           String
  groupId            String?
  participantId      String?
  userId             String
  createdByUserId    String
  assessmentMode     String
  triggerKind        String
  status             String
  version            Int
  rubricSnapshot     Json
  promptVersion      String
  schemaVersion      String
  provider           String
  model              String
  connectionId       String
  requestPayload     Json
  rawResponse        String?
  parsedResponse     Json?
  sanitizedFeedback  Json?
  criterionScores    Json?
  deterministicScore Float
  aiScore            Float?
  combinedScore      Float?
  testWeightPercent  Int
  aiWeightPercent    Int
  submissionHash     String
  feedbackHash       String?
  latencyMs          Int?
  tokenUsage         Json?
  error              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([activityId, executionId, version])
  @@index([activityId, createdAt])
  @@index([executionId, createdAt])
  @@index([coreAttemptId, createdAt])
  @@index([courseId, createdAt])
  @@index([participantId, createdAt])
  @@index([status, createdAt])
}
