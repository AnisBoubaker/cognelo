# Copy this file to judge0.conf on the sandbox host, replace every
# REPLACE_* value, and keep the resulting file mode 0600.

JUDGE0_TELEMETRY_ENABLE=false
RESTART_MAX_TRIES=10
MAINTENANCE_MODE=false

# Cognelo currently creates synchronous submissions with wait=true.
ENABLE_WAIT_RESULT=true
ENABLE_COMPILER_OPTIONS=false
ENABLE_COMMAND_LINE_ARGUMENTS=false
ENABLE_SUBMISSION_DELETE=false
ENABLE_BATCHED_SUBMISSIONS=false
ENABLE_CALLBACKS=false
ENABLE_ADDITIONAL_FILES=false
USE_DOCS_AS_HOMEPAGE=false

INTERVAL=0.1
COUNT=2
MAX_QUEUE_SIZE=100

# Network access to the published port must also be restricted at the private
# network/firewall layer. Authentication remains mandatory.
ALLOW_ORIGIN=
DISALLOW_ORIGIN=
ALLOW_IP=
DISALLOW_IP=
AUTHN_HEADER=X-Auth-Token
AUTHN_TOKEN=REPLACE_JUDGE0_AUTH_TOKEN
AUTHZ_HEADER=X-Auth-User
AUTHZ_TOKEN=

REDIS_HOST=judge0-redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD

POSTGRES_HOST=judge0-db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD

CPU_TIME_LIMIT=5
MAX_CPU_TIME_LIMIT=5
CPU_EXTRA_TIME=1
MAX_CPU_EXTRA_TIME=1
WALL_TIME_LIMIT=10
MAX_WALL_TIME_LIMIT=10
MEMORY_LIMIT=128000
MAX_MEMORY_LIMIT=128000
STACK_LIMIT=64000
MAX_STACK_LIMIT=64000
MAX_PROCESSES_AND_OR_THREADS=60
MAX_MAX_PROCESSES_AND_OR_THREADS=60
ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=true
ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=true
MAX_FILE_SIZE=1024
MAX_MAX_FILE_SIZE=1024
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=1
REDIRECT_STDERR_TO_STDOUT=false
MAX_EXTRACT_SIZE=10240
ALLOW_ENABLE_NETWORK=false
ENABLE_NETWORK=false

RAILS_ENV=production
RAILS_MAX_THREADS=4
RAILS_SERVER_PROCESSES=2
SECRET_KEY_BASE=REPLACE_SECRET_KEY_BASE
