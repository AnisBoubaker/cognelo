{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@cognelo/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@cognelo/core": [
        "../../packages/core/src/index.ts"
      ],
      "@cognelo/db": [
        "../../packages/db/src/index.ts"
      ],
      "@cognelo/activity-sdk": [
        "../../packages/activity-sdk/src/index.ts"
      ],
      "@cognelo/activity-sdk/categories": [
        "../../packages/activity-sdk/src/categories.ts"
      ],
      "@cognelo/content-type-sdk": [
        "../../packages/content-type-sdk/src/index.ts"
      ],
      "@cognelo/content-type-sdk/server": [
        "../../packages/content-type-sdk/src/server.ts"
      ],
      "@cognelo/plugin-file-content": [
        "../../packages/plugin-content-types/plugin-file/src/index.ts"
      ],
      "@cognelo/plugin-github-repo": [
        "../../packages/plugin-content-types/plugin-github-repo/src/index.ts"
      ],
      "@cognelo/plugin-text-content": [
        "../../packages/plugin-content-types/plugin-text/src/index.ts"
      ],
      "@cognelo/activity-ui": [
        "../../packages/activity-ui/src/index.ts"
      ],
      "@cognelo/plugin-homework-grader": [
        "../../packages/plugin-activities/plugin-homework-grader/src/index.ts"
      ],
      "@cognelo/plugin-coding-exercises": [
        "../../packages/plugin-activities/plugin-coding-exercises/src/index.ts"
      ],
      "@cognelo/plugin-parsons": [
        "../../packages/plugin-activities/plugin-parsons/src/index.ts"
      ],
      "@cognelo/plugin-placeholder": [
        "../../packages/plugin-activities/plugin-placeholder/src/index.ts"
      ],
      "@cognelo/plugin-mcq": [
        "../../packages/plugin-activities/plugin-mcq/src/index.ts"
      ],
      "@cognelo/plugin-web-design-coding-exercises": [
        "../../packages/plugin-activities/plugin-web-design-coding-exercises/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
