{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@cognelo/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@cognelo/activity-ui": [
        "../../packages/activity-ui/src/index.ts"
      ],
      "@cognelo/core": [
        "../../packages/core/src/index.ts"
      ],
      "@cognelo/db": [
        "../../packages/db/src/index.ts"
      ],
      "@cognelo/activity-sdk": [
        "../../packages/activity-sdk/src/index.ts"
      ],
      "@cognelo/activity-sdk/server": [
        "../../packages/activity-sdk/src/server.ts"
      ],
      "@cognelo/content-type-sdk": [
        "../../packages/content-type-sdk/src/index.ts"
      ],
      "@cognelo/content-type-sdk/server": [
        "../../packages/content-type-sdk/src/server.ts"
      ],
      "@cognelo/content-type-sdk/vector": [
        "../../packages/content-type-sdk/src/vector.ts"
      ],
      "@cognelo/plugin-registry": [
        "../../packages/plugin-registry/src/index.ts"
      ],
      "@cognelo/plugin-registry/server": [
        "../../packages/plugin-registry/src/server.ts"
      ],
      "@cognelo/config": [
        "../../packages/config/src/index.ts"
      ]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules"
  ]
}
